# Bloom & Petal Nepal - Environment Variables Template
# Copy this file to .env and fill in with your actual values

# Google Generative AI - Required for AI-powered recommendations
# Get your API key from: https://ai.google.dev
VITE_GEMINI_API_KEY=your_api_key_here

# Backend API Configuration
# Update these when you set up your backend server
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# Environment Mode
# Values: development | production | staging
NODE_ENV=development

# Payment Gateway Configuration
# Choose your payment provider and add credentials here

# Stripe (if using Stripe)
# VITE_STRIPE_PUBLIC_KEY=pk_test_your_key_here

# eSewa (for Nepal payments)
# VITE_ESEWA_MERCHANT_CODE=your_merchant_code
# VITE_ESEWA_SANDBOX_MODE=true

# IME Pay (for Nepal payments)
# VITE_IME_MERCHANT_CODE=your_merchant_code

# Khalti (for Nepal payments)
# VITE_KHALTI_PUBLIC_KEY=your_public_key

# Email Configuration
# Update with your email service credentials
VITE_EMAIL_SERVICE_API_KEY=your_api_key_here
VITE_SENDER_EMAIL=noreply@bloompetal.com

# Analytics & Monitoring
# Optional: Set up analytics services
VITE_GOOGLE_ANALYTICS_ID=G_XXXXXXXXXX
VITE_SENTRY_DSN=https://your_sentry_url

# Firebase Configuration (optional, for real-time features)
# VITE_FIREBASE_API_KEY=your_key
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Feature Flags
# Use these to enable/disable features in production
VITE_ENABLE_PAYMENT=false
VITE_ENABLE_EMAIL_NOTIFICATIONS=false
VITE_ENABLE_REAL_TIME_UPDATES=false
VITE_ENABLE_ANALYTICS=false

# Application Configuration
# Shop settings
VITE_SHOP_NAME=Bloom & Petal Nepal
VITE_SHOP_CURRENCY=NPR
VITE_SHOP_PHONE=+977-1-XXXXX
VITE_SHOP_EMAIL=info@bloompetal.com

# Delivery Configuration
VITE_DELIVERY_CHARGE=100
VITE_MIN_ORDER_VALUE=500
VITE_MAX_DELIVERY_TIME_DAYS=3

# Feature Availability
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_MOCK_DATA=true
VITE_API_MOCK_DELAY=500

# Logging
VITE_LOG_LEVEL=info
VITE_LOG_TO_CONSOLE=true
VITE_LOG_TO_FILE=false

# Security
VITE_ALLOW_CONSOLE_LOGS=false
VITE_REQUIRE_HTTPS=false

# Development Overrides
# Set to true to use these in development despite NODE_ENV
VITE_FORCE_PRODUCTION_MODE=false
